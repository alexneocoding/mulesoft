	<!-- Configuration Properties -->
	<configuration-properties file="config.properties" doc:name="Configuration properties" doc:id="configuration-properties" />

	<!-- HTTP Listener Configuration -->
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="http-listener-config">
		<http:listener-connection host="${http.host}" port="${http.port}" />
	</http:listener-config>

	<!-- AI Inference Configuration -->
	<ms-inference:text-generation-config name="MuleSoft_Inference_Text_generation_config" doc:name="MuleSoft Inference Text generation config" doc:id="c08f59bd-a467-4f75-9632-5e2b4fca7eca">
		<ms-inference:openai-connection apiKey="#[p('llm.openai.api.key')]" temperature="0" topP="1" />
	</ms-inference:text-generation-config>

	<!-- Global Configuration for Validation -->
	<validation:config name="Validation_Config" doc:name="Validation Config" doc:id="validation-config" />

	<!-- Global Error Handler -->
	<os:object-store name="Object_Store_PurchaseOrders" doc:name="Object store" doc:id="93bb1463-5a51-47d5-99cb-2d1ee84c9485" config-ref="Object_Store_Config_PurchaseOrders"/>
	<os:config name="Object_Store_Config_PurchaseOrders" doc:name="ObjectStore Config" doc:id="df67dbd4-b00d-40cb-97b3-1343e04fd385" >
		<os:connection >
			<reconnection />
		</os:connection>
	</os:config>
	<configuration doc:name="Configuration" doc:id="b7705247-3331-4c8d-812f-f80e56330c5b" defaultErrorHandler-ref="global-error-handler" />

</mule>