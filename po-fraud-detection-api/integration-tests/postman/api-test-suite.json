    "item": [
        {
            "name": "Success Case - Partner with history - Suspicious PO (No  historical data)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Response has required fields\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('transactionId');",
                            "    pm.expect(jsonData).to.have.property('timeStamp');",
                            "    pm.expect(jsonData).to.have.property('poNumber');",
                            "    pm.expect(jsonData).to.have.property('fraudAssessment');",
                            "    pm.expect(jsonData).to.have.property('status');",
                            "});",
                            "",
                            "pm.test(\"Fraud assessment has required fields\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.fraudAssessment).to.have.property('riskLevel');",
                            "    pm.expect(jsonData.fraudAssessment).to.have.property('riskScore');",
                            "    pm.expect(jsonData.fraudAssessment).to.have.property('fraudIndicators');",
                            "    pm.expect(jsonData.fraudAssessment).to.have.property('recommendation');",
                            "    pm.expect(jsonData.fraudAssessment).to.have.property('aiConfidence');",
                            "});",
                            "",
                            "pm.test(\"Risk level is valid\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    var validRiskLevels = ['HIGH', 'MEDIUM', 'LOW', 'MINIMAL'];",
                            "    pm.expect(validRiskLevels).to.include(jsonData.fraudAssessment.riskLevel);",
                            "});",
                            "",
                            "pm.test(\"Risk score is within valid range\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.fraudAssessment.riskScore).to.be.at.least(0);",
                            "    pm.expect(jsonData.fraudAssessment.riskScore).to.be.at.most(100);",
                            "});",
                            "",
                            "pm.test(\"Status is ANALYZED\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.status).to.eql('ANALYZED');",
                            "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"poNumber\": \"PO-zzz\",\n  \"vendorId\": \"APL-RESSELER\",\n  \"amount\": 1998.00,\n  \"poDate\": \"2025-12-08\",\n  \"description\": \"iPhone 15, 2 unit\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/fraud-detection/analyze",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "fraud-detection",
                        "analyze"
                    ]
                },
                "description": "Tests a valid PO request with moderate amount that should be successfully analyzed by the AI fraud detection system. This represents a typical business transaction that should pass validation and receive a fraud risk assessment."
            },
            "response": []
        },
