<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools" xmlns:http="http://www.mulesoft.org/schema/mule/http" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
  http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
  http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
  http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

	<!-- Test Suite for PO Fraud Detection API -->
	<munit:config name="po-fraud-detection-test-suite.xml" />

	<!-- Test: Low Risk PO -->
	<munit:test name="test-low-risk-po" doc:id="test-low-risk-po" description="Test PO with low fraud risk">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock AI Chain Response" processor="aichain:llm-chat">
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"response": "{\"riskScore\": 20, \"indicators\": [\"Low amount\"], \"reasoning\": \"Standard office supplies purchase\", \"confidence\": 85}"
					}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-001",
				"vendorId": "VENDOR-12345",
				"amount": 5000,
				"poDate": "2023-12-01",
				"description": "Office supplies purchase"
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="d9a63f61-6a5f-41e4-8d63-01bb44a3a6c9"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status is ANALYZED" expression="#[payload.status]" is="#[MunitTools::equalTo('ANALYZED')]" />
		</munit:validation>
	</munit:test>

	<!-- Test: High Risk PO - Large Amount -->
	<munit:test name="test-high-risk-large-amount" doc:id="test-high-risk-large-amount" description="Test PO with high amount triggering fraud alert">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock AI Chain Response" processor="aichain:llm-chat">
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"response": "{\"riskScore\": 90, \"riskLevel\": \"HIGH\", \"fraudIndicators\": [\"Unusually large amount\", \"Future date\"], \"recommendation\": \"REJECT - High fraud risk\", \"reasoning\": \"Large amount with suspicious characteristics\", \"confidence\": 95}"
					}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-002",
				"vendorId": "12",
				"amount": 150000,
				"poDate": "2025-01-01",
				"description": "Suspicious large purchase"
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="9848cf8a-ff8a-40d9-9266-b7d718bd1388"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status is ANALYZED" expression="#[payload.status]" is="#[MunitTools::equalTo('ANALYZED')]" />
		</munit:validation>
	</munit:test>

	<!-- Test: Medium Risk PO - Suspicious Vendor -->
	<munit:test name="test-medium-risk-suspicious-vendor" doc:id="test-medium-risk-suspicious-vendor" description="Test PO with suspicious vendor information">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock AI Chain Response" processor="aichain:llm-chat">
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"response": "{\"riskScore\": 65, \"riskLevel\": \"MEDIUM\", \"fraudIndicators\": [\"Test or temporary vendor\"], \"recommendation\": \"REVIEW - Medium risk\", \"reasoning\": \"Suspicious vendor identifier\", \"confidence\": 80}"
					}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-003",
				"vendorId": "TEST-VENDOR",
				"amount": 75000,
				"poDate": "2023-12-01",
				"description": "Equipment purchase from test vendor"
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="0b164525-b9df-4879-a31e-e8deb8e33d3b"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status is ANALYZED" expression="#[payload.status]" is="#[MunitTools::equalTo('ANALYZED')]" />
		</munit:validation>
	</munit:test>

	<!-- Test: Validation Error - Missing Required Fields -->
	<munit:test name="test-validation-error-missing-fields" doc:id="test-validation-error-missing-fields" description="Test validation error for missing required fields" expectedErrorType="VALIDATION:NULL">
		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-004",
				"amount": 5000
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="c4b41211-d08d-487d-b704-8f1ecd0ffd74"/>
		</munit:execution>
	</munit:test>

	<!-- Test: Round Number Amount Detection -->
	<munit:test name="test-round-number-detection" doc:id="test-round-number-detection" description="Test detection of suspicious round number amounts">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock AI Chain Response" processor="aichain:llm-chat">
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"response": "{\"riskScore\": 45, \"riskLevel\": \"MEDIUM\", \"fraudIndicators\": [\"Suspicious round number\"], \"recommendation\": \"REVIEW\", \"reasoning\": \"Round number amounts can indicate fraud\", \"confidence\": 75}"
					}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-005",
				"vendorId": "VENDOR-67890",
				"amount": 50000,
				"poDate": "2023-12-01",
				"description": "Round number purchase"
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="ecb76f49-2a33-4c0c-9524-f58703a7ce1e"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status is ANALYZED" expression="#[payload.status]" is="#[MunitTools::equalTo('ANALYZED')]" />
		</munit:validation>
	</munit:test>

	<!-- Test: Future Date Detection -->
	<munit:test name="test-future-date-detection" doc:id="test-future-date-detection" description="Test detection of future-dated purchase orders">
		<munit:behavior>
			<munit-tools:mock-when doc:name="Mock AI Chain Response" processor="aichain:llm-chat">
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"response": "{\"riskScore\": 70, \"riskLevel\": \"HIGH\", \"fraudIndicators\": [\"Future-dated purchase order\"], \"recommendation\": \"REJECT\", \"reasoning\": \"Future dates are highly suspicious\", \"confidence\": 90}"
					}]' />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<set-payload value='#[{
				"poNumber": "PO-2023-006",
				"vendorId": "VENDOR-FUTURE",
				"amount": 25000,
				"poDate": "2025-12-31",
				"description": "Future dated purchase order"
			}]' doc:name="Set Test Payload" />

			<flow-ref doc:name="Call Main Flow" name="main-flow" doc:id="e113278c-7060-4b61-b3f2-10cefd383dc3"/>
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-that doc:name="Assert Status is ANALYZED" expression="#[payload.status]" is="#[MunitTools::equalTo('ANALYZED')]" />
		</munit:validation>
	</munit:test>

</mule>