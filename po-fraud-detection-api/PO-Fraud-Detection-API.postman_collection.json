{
	"info": {
		"_postman_id": "po-fraud-detection-api-collection",
		"name": "PO Fraud Detection API - Essential Test Suite",
		"description": "Essential test collection for the PO Fraud Detection API with AI-powered analysis. Contains one success case and one failure case for basic testing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "po-fraud-detection"
	},
	"item": [
		{
			"name": "Success Case - Valid PO Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('transactionId');",
							"    pm.expect(jsonData).to.have.property('timeStamp');",
							"    pm.expect(jsonData).to.have.property('poNumber');",
							"    pm.expect(jsonData).to.have.property('fraudAssessment');",
							"    pm.expect(jsonData).to.have.property('status');",
							"});",
							"",
							"pm.test(\"Fraud assessment has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.fraudAssessment).to.have.property('riskLevel');",
							"    pm.expect(jsonData.fraudAssessment).to.have.property('riskScore');",
							"    pm.expect(jsonData.fraudAssessment).to.have.property('fraudIndicators');",
							"    pm.expect(jsonData.fraudAssessment).to.have.property('recommendation');",
							"    pm.expect(jsonData.fraudAssessment).to.have.property('aiConfidence');",
							"});",
							"",
							"pm.test(\"Risk level is valid\", function () {",
							"    var jsonData = pm.response.json();",
							"    var validRiskLevels = ['HIGH', 'MEDIUM', 'LOW', 'MINIMAL'];",
							"    pm.expect(validRiskLevels).to.include(jsonData.fraudAssessment.riskLevel);",
							"});",
							"",
							"pm.test(\"Risk score is within valid range\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.fraudAssessment.riskScore).to.be.at.least(0);",
							"    pm.expect(jsonData.fraudAssessment.riskScore).to.be.at.most(100);",
							"});",
							"",
							"pm.test(\"Status is ANALYZED\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql('ANALYZED');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"poNumber\": \"PO-2024-001\",\n  \"vendorId\": \"VENDOR-ACME-001\",\n  \"amount\": 25000.00,\n  \"poDate\": \"2024-12-04\",\n  \"description\": \"IT equipment upgrade - laptops and monitors for office expansion\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/fraud-detection/analyze",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"fraud-detection",
						"analyze"
					]
				},
				"description": "Tests a valid PO request with moderate amount that should be successfully analyzed by the AI fraud detection system. This represents a typical business transaction that should pass validation and receive a fraud risk assessment."
			},
			"response": []
		},
		{
			"name": "Failure Case - Missing Required Field",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Response has error information\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('error');",
							"    pm.expect(jsonData).to.have.property('message');",
							"    pm.expect(jsonData).to.have.property('timestamp');",
							"});",
							"",
							"pm.test(\"Error type is validation error\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.error).to.eql('VALIDATION_ERROR');",
							"});",
							"",
							"pm.test(\"Error message indicates validation failure\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include('Invalid input data');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"vendorId\": \"VENDOR-TEST-001\",\n  \"amount\": 5000.00,\n  \"poDate\": \"2024-12-04\",\n  \"description\": \"Test order without PO number - should fail validation\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/fraud-detection/analyze",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"fraud-detection",
						"analyze"
					]
				},
				"description": "Tests validation error handling by sending a request missing the required 'poNumber' field. This should trigger the validation flow and return a 400 error with appropriate error message."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set base URL if not already set",
					"if (!pm.environment.get('baseUrl')) {",
					"    pm.environment.set('baseUrl', 'http://localhost:8081');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		}
	]
}
