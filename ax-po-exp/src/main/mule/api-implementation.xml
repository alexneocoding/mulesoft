<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:tracking="http://www.mulesoft.org/schema/mule/ee/tracking" 
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
		http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
http://www.mulesoft.org/schema/mule/ee/tracking http://www.mulesoft.org/schema/mule/ee/tracking/current/mule-tracking-ee.xsd">


	<!-- Input Validation Sub-flow -->
	<sub-flow name="validate-input-subflow">
		<logger level="DEBUG" doc:name="Log Validation Start" doc:id="log-validation-start" message="Starting input validation" />
		
		<!-- Check if payload exists and is not empty -->
		<validation:is-not-null doc:name="Validate Payload Exists" doc:id="validate-payload-exists" 
			value="#[payload]" message="Missing required PDF data" />
		
		<!-- Validate multipart structure exists -->
		
		<!-- Validate file part exists -->
		<validation:is-not-null doc:name="Validate File Part Exists" doc:id="validate-file-part-exists" 
			value="#[payload.parts.file]" message="Missing required file parameter" />
		
		<!-- Validate file content exists -->
		<validation:is-not-null doc:name="Validate File Content Exists" doc:id="validate-file-content-exists" 
			value="#[payload.parts.file.content]" message="File content cannot be empty" />
		
		<!-- Validate file content is not empty -->
		<validation:is-true doc:name="Validate File Content Not Empty" doc:id="validate-file-content-not-empty" 
			expression="#[sizeOf(payload.parts.file.content) &gt; 0]" 
			message="PDF file cannot be empty" />
		
		<!-- Validate file size (10MB limit) -->
		<validation:is-true doc:name="Validate File Size" doc:id="validate-file-size" 
			expression="#[sizeOf(payload.parts.file.content) &lt;= 10485760]"
			message="File size exceeds maximum allowed limit of 10MB" />
		
		<!-- Validate Content-Type if available -->
		<validation:is-true doc:name="Validate PDF Content Type" doc:id="validate-pdf-content-type" 
			message="Invalid file format. Only PDF files are allowed" expression="#[payload.parts.file.headers['Content-Type']  == 'application/pdf']"/>
		
		<logger level="DEBUG" doc:name="Log Validation Success" doc:id="log-validation-success" 
			message="Input validation completed successfully - PDF size: #[sizeOf(payload.file.content)] bytes" />
	</sub-flow>

	<!-- OAuth Token Acquisition Sub-flow -->
	<sub-flow name="get-oauth-token-subflow">
		<logger level="DEBUG" doc:name="Log Token Request Start" doc:id="log-token-request-start" message="Requesting OAuth access token" />
		
		<ee:transform doc:name="Prepare Token Request" doc:id="prepare-token-request">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/x-www-form-urlencoded
---
{
	client_id: p('idp.client.id'),
	client_secret: p('idp.client.secret'),
	grant_type: "client_credentials"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		
		<http:request method="POST" doc:name="Request OAuth Token" doc:id="request-oauth-token" 
			config-ref="OAuth_Token_Request_Config" path="/accounts/api/v2/oauth2/token"
			responseTimeout="${http.request.timeout}">
			<http:headers><![CDATA[#[output application/java
---
{
	"Content-Type" : "application/x-www-form-urlencoded"
}]]]></http:headers>
		</http:request>
		
		<ee:transform doc:name="Extract Access Token" doc:id="extract-access-token">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
payload]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="accessToken"><![CDATA[%dw 2.0
output application/java
---
payload.access_token]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<validation:is-not-null doc:name="Validate Token Received" doc:id="validate-token-received" 
			value="#[vars.accessToken]" message="Failed to obtain access token from OAuth service" />
		
		<logger level="DEBUG" doc:name="Log Token Success" doc:id="log-token-success" message="OAuth access token obtained successfully" />
	</sub-flow>

	<!-- IDP Submission Sub-flow -->
	<sub-flow name="submit-to-idp-subflow">
		<logger level="DEBUG" doc:name="Log IDP Submission Start" doc:id="log-idp-submission-start" message="Submitting PDF to IDP service" />
		
		<ee:transform doc:name="Prepare IDP Request" doc:id="prepare-idp-request">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output multipart/form-data
---
{
	parts: {
		file: {
			headers: {
				"Content-Disposition": {
					"name": "file",
					"filename": vars.originalFileName
				},
				"Content-Type": "application/pdf"
			},
			content: vars.pdfContent
		}
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST" doc:name="Submit to IDP" doc:id="submit-to-idp" 
			config-ref="IDP_Execution_Request_Config" 
			path="/api/v1/organizations/37513a5c-61c8-4566-8c30-c9d2a08150d8/actions/494653c9-bf1a-4013-8997-228021e7b21c/versions/1.0.0/executions"
			responseTimeout="${http.request.timeout}">
			<http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer " ++ (vars.accessToken default "")
}]]]></http:headers>
		</http:request>
		
		<ee:transform doc:name="Extract Execution ID" doc:id="extract-execution-id">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
payload]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="executionId"><![CDATA[%dw 2.0
output application/java
---
payload.id]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<validation:is-not-null doc:name="Validate Execution ID" doc:id="validate-execution-id" 
			value="#[vars.executionId]" message="Failed to obtain execution ID from IDP service" />
		
		<logger level="DEBUG" doc:name="Log IDP Submission Success" doc:id="log-idp-submission-success" 
			message="PDF submitted to IDP successfully - Execution ID: #[vars.executionId]" />
	</sub-flow>

	<!-- Intelligent Polling Sub-flow -->
	<sub-flow name="wait-processing-subflow">
		<logger level="DEBUG" doc:name="Log Polling Start" doc:id="log-polling-start" 
			message="Starting intelligent polling for IDP processing - Execution ID: #[vars.executionId]" />
		
		<ee:transform doc:name="Initialize Polling Variables" doc:id="initialize-polling-variables">
			<ee:variables>
				<ee:set-variable variableName="waitTimeMs"><![CDATA[%dw 2.0
output application/java
---
(p('idp.poll.wait.seconds') as Number) * 1000]]></ee:set-variable>
				<ee:set-variable variableName="maxAttempts"><![CDATA[%dw 2.0
output application/java
---
p('idp.poll.max.attempts')]]></ee:set-variable>
				<ee:set-variable variableName="finalStatuses"><![CDATA[%dw 2.0
output application/java
---
["SUCCEEDED", "FAILED", "ERROR", "MANUAL_VALIDATION_REQUIRED"]]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<!-- Intelligent polling loop -->
		<until-successful maxRetries="#[vars.maxAttempts]" doc:name="Poll IDP Status" doc:id="poll-idp-status" 
			millisBetweenRetries="#[vars.waitTimeMs]">
			
			<logger level="DEBUG" doc:name="Log Polling Attempt" doc:id="log-polling-attempt" 
				message="Polling IDP status - Execution ID: #[vars.executionId]" />
			
			<!-- Get current status from IDP -->
			<http:request method="GET" doc:name="Check IDP Status" doc:id="check-idp-status" 
				config-ref="IDP_Status_Request_Config" 
				path="#['/api/v1/organizations/37513a5c-61c8-4566-8c30-c9d2a08150d8/actions/494653c9-bf1a-4013-8997-228021e7b21c/versions/1.0.0/executions/' ++ (vars.executionId default '')]"
				responseTimeout="${http.request.timeout}">
				<http:headers><![CDATA[#[output application/java
---
{
	"Authorization" : "Bearer " ++ (vars.accessToken default "")
}]]]></http:headers>
			</http:request>
			
			<!-- Log complete IDP response -->
			<logger level="INFO" doc:name="Log IDP Response" doc:id="log-idp-response" 
				message="IDP Status Response: #[if (payload != null) write(payload, 'application/json') else 'null']" />
			
			<!-- Check if status is final -->
			<ee:transform doc:name="Check Status" doc:id="check-status">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="currentStatus"><![CDATA[%dw 2.0
output application/java
---
payload.status]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			
			<logger level="DEBUG" doc:name="Log Current Status" doc:id="log-current-status" 
				message="Current IDP status: #[vars.currentStatus]" />
			
			<!-- If status is final, exit successfully. Otherwise, throw exception to continue polling -->
			<choice doc:name="Status Decision" doc:id="status-decision">
				<when expression="#[vars.finalStatuses contains vars.currentStatus]">
					<logger level="INFO" doc:name="Log Final Status" doc:id="log-final-status" 
						message="IDP processing completed with final status: #[vars.currentStatus]" />
				</when>
				<otherwise>
					<logger level="DEBUG" doc:name="Log Continue Polling" doc:id="log-continue-polling" 
						message="Status '#[vars.currentStatus]' is not final, continuing to poll..." />
					<raise-error doc:name="Continue Polling" doc:id="continue-polling" 
						type="CUSTOM:CONTINUE_POLLING" description="Status not final, continue polling" />
				</otherwise>
			</choice>
		</until-successful>
		
		<logger level="INFO" doc:name="Log Polling Success" doc:id="log-polling-success" 
			message="IDP polling completed successfully - Final status: #[vars.currentStatus]" />
	</sub-flow>

	<!-- IDP Results Retrieval Sub-flow -->
	<sub-flow name="send-to-apm" doc:id="a848a522-443b-4af6-81a5-603c6599d881" >
		<logger level="DEBUG" doc:name="Send to APM Start" doc:id="f71f9c34-7587-4340-9fff-378e996092d0" message="Sending to APM - Execution ID: #[vars.executionId]" />
		<ee:transform doc:name="Prepare Request to Anypoint Partner Manager" doc:id="b64f976d-3fc0-4b78-902a-9e1e65226392" >
			<ee:message >
				<ee:set-payload resource="dwl/map-ax-tw-po-to-ax-tw-po-apm-received.dwl" />
			</ee:message>
		</ee:transform>
		<http:request doc:name="Send Purchase Order to Anypoint Partner Manager" doc:id="cd0d4d9d-b563-4a95-945f-0b72929a134f" config-ref="APM_http_inbout_JSON" path="#[p('apm.execution.url')]" method="POST"/>
		<logger level="DEBUG" doc:name="Log Send Request to APM" doc:id="a61dbddb-4f77-45cb-8939-60fa5be97f7f" message="#[payload]" />
		<logger level="DEBUG" doc:name="Send to APM Success" doc:id="2904dcdd-8d0c-4e30-98ff-39af7ccb6fb9" message="PurchasOrder sent to APM successfully" />
	</sub-flow>


</mule>
