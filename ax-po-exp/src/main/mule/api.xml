<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" 
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!-- Main Purchase Order Processing Flow -->
	<flow name="purchase-order-main-flow" doc:id="purchase-order-main-flow">
		<http:listener doc:name="HTTP Listener" doc:id="http-listener" 
			config-ref="HTTP_Listener_config" 
			path="${http.listener.basePath}/purchase-orders" 
			allowedMethods="POST" />

		<!-- Log incoming request -->
		<logger level="INFO" doc:name="Log Request Start" doc:id="log-request-start" 
			message="Processing purchase order request - Correlation ID: #[correlationId]" />

		<!-- Debug: Log payload structure -->
		<logger level="DEBUG" doc:name="Debug Payload Structure" doc:id="debug-payload-structure" 
			message="Payload type: #[typeOf(payload)] | Payload class: #[payload.getClass().getName()] | Media Type: #[attributes.headers.'content-type']" />

		<!-- Parse multipart data -->
		<ee:transform doc:name="Parse Multipart" doc:id="parse-multipart">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>

		<!-- Step 1: Input Validation -->
		<flow-ref doc:name="Validate Input" doc:id="validate-input-flow-ref" name="validate-input-subflow" />
		
		<!-- Step 1.5: Store PDF Data Before OAuth Call -->
		<ee:transform doc:name="Store PDF Data" doc:id="store-pdf-data">
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
import dw::core::Binaries
---
// Extract the first file from multipart data
payload.parts[0].content]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="pdfContent" ><![CDATA[%dw 2.0
output application/java
---
payload.parts[0].content]]></ee:set-variable>
				<ee:set-variable variableName="originalFileName" ><![CDATA[%dw 2.0
output text/plain
---
payload.parts[0].headers."Content-Disposition".filename default "document.pdf"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<!-- Step 2: Get OAuth Access Token -->
		<flow-ref doc:name="Get OAuth Token" doc:id="get-oauth-token-flow-ref" name="get-oauth-token-subflow" />
		
		<!-- Step 3: Submit PDF to IDP -->
		<flow-ref doc:name="Submit to IDP" doc:id="submit-to-idp-flow-ref" name="submit-to-idp-subflow" />
		
		<!-- Step 4: Wait for Processing and Retrieve Results -->
		<flow-ref doc:name="Wait for Processing and Retrieve Results" doc:id="wait-processing-flow-ref" name="wait-processing-subflow" />
		
		<flow-ref doc:name="Send to Anypoint Partner Manager" doc:id="495b16f7-4e7c-49f2-8b4b-c98b3cb2717d" name="send-to-apm"/>
		<logger level="INFO" doc:name="Log Success" doc:id="log-success" 
			message="Successfully processed purchase order - Correlation ID: #[correlationId]" />
	</flow>

</mule>
