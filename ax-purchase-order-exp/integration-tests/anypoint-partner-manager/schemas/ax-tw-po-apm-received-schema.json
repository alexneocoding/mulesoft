{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/json-ax-tw-po-apm-received-schema.json",
  "title": "APM Received Purchase Order JSON",
  "type": "object",
  "required": ["partnerReferenceId", "hostReferenceId", "referenceId", "transaction"],
  "properties": {
    "partnerReferenceId": {
      "type": "string",
       "additionalProperties": true
    },
    "hostReferenceId": {
      "type": "string",
      "additionalProperties": true
    },
    "referenceId": {
      "type": "string",
      "description": "APM transmission or correlation reference"
    },
    "transaction": {
      "type": "object",
      "required": ["transactionType", "payload"],
      "properties": {
        "transactionType": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "required": [
            "DocumentName",
            "Status",
            "PurchaseOrderNumber",
            "PurchaseOrderDate",
            "Items"
          ],
          "properties": {
            "DocumentName": {
              "type": "string"
            },
            "Status": {
              "type": "string"
            },
            "Vendor": {
              "$ref": "#/$defs/party"
            },
            "Buyer": {
              "type": "object",
              "properties": {
                "Name": { "type": "string" },
                "BuyerPhone": { "type": ["string", "null"] },
                "Address": { "$ref": "#/$defs/address" }
              },
              "additionalProperties": true
            },
            "PurchaseOrderNumber": {
              "type": "string"
            },
            "PurchaseOrderDate": {
              "type": "string"
            },
            "Subtotal": {
              "type": ["number", "integer", "null"],
              "minimum": 0
            },
            "Tax": {
              "type": ["number", "integer", "null"],
              "minimum": 0
            },
            "Total": {
              "type": ["number", "integer", "null"],
              "minimum": 0
            },
            "AmountDue": {
              "type": ["number", "integer", "null"],
              "minimum": 0
            },
            "ShipToName": {
              "type": ["string", "null"]
            },
            "ShipToAddress": {
              "$ref": "#/$defs/address"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,

  "$defs": {
    "address": {
      "type": "object",
      "properties": {
        "line1": { "type": "string" },
        "line2": { "type": ["string", "null"] },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zipCode": { "type": "string" },
        "country": { "type": "string" }
      },
      "additionalProperties": true
    },
    "party": {
      "type": "object",
      "properties": {
        "Name": { "type": "string" },
        "Address": { "$ref": "#/$defs/address" }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "properties": {
        "productCode": { "type": "string" },
        "quantity": { "type": ["number", "integer"] },
        "unitPrice": { "type": ["number", "integer"] },
        "price": { "type": ["number", "integer"] },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
