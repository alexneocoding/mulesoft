{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ax-tw-po-received-schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["senderId", "receiverId", "transaction"],
  "properties": {
    "senderId": {
      "type": "string",
      "minLength": 1
    },
    "receiverId": {
      "type": "string",
      "minLength": 1
    },
    "transaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["transactionType", "payload"],
      "properties": {
        "transactionType": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "DocumentId",
            "DocumentName",
            "Status",
            "Vendor",
            "Buyer",
            "PurchaseOrderNumber",
            "PurchaseOrderDate",
            "Items"
          ],
          "properties": {
            "DocumentId": {
              "type": "string"
            },
            "DocumentName": {
              "type": "string"
            },
            "Status": {
              "type": "string"
            },
            "Vendor": {
              "type": "object",
              "additionalProperties": true,
              "required": ["Name", "Address"],
              "properties": {
                "Name": {
                  "type": "string"
                },
                "Address": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "line1": { "type": "string" },
                    "city": { "type": "string" },
                    "state": { "type": "string" },
                    "zipCode": { "type": "string" },
                    "country": { "type": "string" }
                  }
                }
              }
            },
            "Buyer": {
              "type": "object",
              "additionalProperties": true,
              "required": ["Name", "Address"],
              "properties": {
                "Name": {
                  "type": "string"
                },
                "BuyerPhone": {
                  "type": ["string", "null"]
                },
                "Address": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "line1": { "type": "string" },
                    "city": { "type": "string" },
                    "state": { "type": "string" },
                    "zipCode": { "type": "string" },
                    "country": { "type": "string" }
                  }
                }
              }
            },
            "PurchaseOrderNumber": {
              "type": "string"
            },
            "PurchaseOrderDate": {
              "type": "string",
              "format": "date"
            },
            "Subtotal": {
              "type": ["number", "integer"]
            },
            "Tax": {
              "type": ["number", "integer"]
            },
            "Total": {
              "type": ["number", "integer"]
            },
            "AmountDue": {
              "type": ["number", "integer"]
            },
            "ShipToName": {
              "type": "string"
            },
            "ShipToAddress": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "line1": { "type": "string" },
                "city": { "type": "string" },
                "state": { "type": "string" },
                "zipCode": { "type": "string" },
                "country": { "type": "string" }
              }
            },
            "Items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["productCode", "quantity", "unitPrice", "price"],
                "properties": {
                  "productCode": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": ["number", "integer"]
                  },
                  "unitPrice": {
                    "type": ["number", "integer"]
                  },
                  "price": {
                    "type": ["number", "integer"]
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
