{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/json-tw-po-schema.json",
  "type": "object",
  "required": ["senderId", "receiverId", "transaction"],
  "properties": {
    "senderId": {
      "$ref": "#/$defs/valueObject"
    },
    "receiverId": {
      "$ref": "#/$defs/valueObject"
    },
    "transaction": {
      "type": "object",
      "required": ["transactionType", "payload"],
      "properties": {
        "transactionType": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/purchaseOrderPayload"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "valueObject": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "purchaseOrderPayload": {
      "type": "object",
      "required": [
        "DocumentId",
        "DocumentName",
        "Status",
        "PurchaseOrderNumber",
        "PurchaseOrderDate",
        "Subtotal",
        "Tax",
        "Total",
        "AmountDue",
        "BuyerName",
        "BuyerAddress",
        "VendorName",
        "VendorAddress",
        "ShipToName",
        "ShipToAddress",
        "Items"
      ],
      "properties": {
        "DocumentId": {
          "type": "string",
          "format": "uuid"
        },
        "DocumentName": {
          "type": "string"
        },
        "Status": {
          "type": "string"
        },
        "PurchaseOrderNumber": {
          "type": "string"
        },
        "PurchaseOrderDate": {
          "type": "string",
          "format": "date"
        },
        "Subtotal": {
          "type": "number"
        },
        "Tax": {
          "type": "number"
        },
        "Total": {
          "type": "number"
        },
        "AmountDue": {
          "type": "number"
        },
        "BuyerName": {
          "type": "string"
        },
        "BuyerAddress": {
          "type": "string"
        },
        "BuyerPhone": {
          "type": ["string", "null"]
        },
        "VendorName": {
          "type": "string"
        },
        "VendorAddress": {
          "type": "string"
        },
        "ShipToName": {
          "type": "string"
        },
        "ShipToAddress": {
          "type": "string"
        },
        "Items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lineItem"
          }
        }
      },
      "additionalProperties": false
    },
    "lineItem": {
      "type": "object",
      "required": [
        "productCode",
        "quantity",
        "unitPrice",
        "price",
        "description"
      ],
      "properties": {
        "productCode": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
