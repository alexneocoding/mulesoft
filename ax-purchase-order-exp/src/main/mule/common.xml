<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core" 
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!-- Common Utilities and Reusable Components -->

	<!-- Correlation ID Generator Sub-flow -->
	<sub-flow name="generate-correlation-id-subflow">
		<ee:transform doc:name="Generate Correlation ID" doc:id="generate-correlation-id">
			<ee:variables>
				<ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
if (correlationId != null) correlationId 
else uuid()]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="DEBUG" doc:name="Log Correlation ID" doc:id="log-correlation-id" message="Generated Correlation ID: #[vars.correlationId]" />
	</sub-flow>

	<!-- Security Logging Sub-flow (excludes sensitive data) -->
	<sub-flow name="secure-request-logging-subflow">
		<logger level="INFO" doc:name="Log Request Details" doc:id="log-request-details" 
			message="Request received - Method: #[attributes.method] Path: #[attributes.requestPath] Content-Type: #[attributes.headers.'content-type'] Correlation ID: #[correlationId]" />
		
		<!-- Log file information without exposing content -->
		<choice doc:name="Log File Info" doc:id="log-file-info">
			<when expression="#[attributes.parts.file != null]">
				<logger level="INFO" doc:name="Log File Details" doc:id="log-file-details" 
					message="File received - Name: #[attributes.parts.file.headers.'content-disposition'] Size: #[sizeOf(attributes.parts.file.content)] bytes Content-Type: #[attributes.parts.file.headers.'Content-Type']" />
			</when>
			<otherwise>
				<logger level="DEBUG" doc:name="No File" doc:id="no-file" message="No file parameter found in request" />
			</otherwise>
		</choice>
	</sub-flow>

	<!-- Response Logging Sub-flow (excludes sensitive data) -->
	<sub-flow name="secure-response-logging-subflow">
		<logger level="INFO" doc:name="Log Response" doc:id="log-response" 
			message="Response sent - Status: #[vars.httpStatus default 200] Size: #[sizeOf(payload)] bytes Correlation ID: #[correlationId]" />
	</sub-flow>

	<!-- Token Validation Sub-flow -->
	<sub-flow name="validate-token-subflow">
		<choice doc:name="Check Token" doc:id="check-token">
			<when expression="#[vars.accessToken != null and sizeOf(vars.accessToken) > 0]">
				<logger level="DEBUG" doc:name="Token Valid" doc:id="token-valid" message="Access token is valid" />
			</when>
			<otherwise>
				<logger level="ERROR" doc:name="Token Invalid" doc:id="token-invalid" message="Access token is missing or invalid" />
				<raise-error doc:name="Raise Token Error" doc:id="raise-token-error" type="CUSTOM:TOKEN_INVALID" description="Access token is missing or invalid" />
			</otherwise>
		</choice>
	</sub-flow>

	<!-- File Cleanup Sub-flow -->
	<sub-flow name="cleanup-resources-subflow">
		<logger level="DEBUG" doc:name="Cleanup Resources" doc:id="cleanup-resources" message="Cleaning up temporary resources" />
		
		<!-- Clear sensitive variables -->
		<ee:transform doc:name="Clear Sensitive Data" doc:id="clear-sensitive-data">
			<ee:variables>
				<ee:set-variable variableName="accessToken">null</ee:set-variable>
			</ee:variables>
		</ee:transform>
		
		<logger level="DEBUG" doc:name="Cleanup Complete" doc:id="cleanup-complete" message="Resource cleanup completed" />
	</sub-flow>

	<!-- Standard Error Response Builder -->
	<sub-flow name="build-error-response-subflow">
		<ee:transform doc:name="Build Error Response" doc:id="build-error-response">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: vars.errorMessage default "An unexpected error occurred",
  timestamp: now(),
  correlationId: correlationId,
  path: attributes.requestPath default "/api/v1/order"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

	<!-- Health Check Sub-flow -->
	<sub-flow name="health-check-subflow">
		<ee:transform doc:name="Health Status" doc:id="health-status">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "UP",
  timestamp: now(),
  service: "ax-purchase-order-exp",
  version: "1.0.0"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>

</mule>
